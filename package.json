{
  "name": "chess-learning-space",
  "version": "1.0.0",
  "description": "A personal browser-only chess learning space",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build:puzzles": "node scripts/build-puzzles.mjs",
    "dev": "vite --host 127.0.0.1",
    "start": "npm run build && vite preview --host 127.0.0.1 --port 4173 --strictPort --open",
    "build": "tsc --noEmit && vite build",
    "check:repertoire": "npm run check:copy && node scripts/check-repertoire.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:copy": "node scripts/check-copy.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fbnkch/chess-learning-space.git"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "bugs": {
    "url": "https://github.com/fbnkch/chess-learning-space/issues"
  },
  "homepage": "https://github.com/fbnkch/chess-learning-space#readme",
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/ibm-plex-serif": "5.3.0",
    "@lichess-org/chessground": "9.2.3",
    "@noble/hashes": "^2.4.0",
    "@vercel/blob": "^2.8.2",
    "chess.js": "^1.4.0",
    "idb": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stockfish": "19.0.1",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.6",
    "fzstd": "^0.1.1",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "$zod"
    }
  }
}
